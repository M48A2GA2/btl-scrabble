216: bool onFirstTile(int row, int col, char dir, string word, Board& board)
217: {
218: 	for(int i = 0; i < (int)word.length(); i++){
219: 		if(dir == '|'){
220: 			if(row + i == board.getStartY() && col == board.getStartX())
221: 				return true;
222: 		}
223: 		else if (dir == '-'){
224: 			if(col + i == board.getStartX() && row == board.getStartY())
225: 				return true;
226: 		}
227: 	}
228: 	return false;
229: }
