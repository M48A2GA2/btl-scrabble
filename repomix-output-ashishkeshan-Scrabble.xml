134: 		word += t->getLetter();
135: 	}
136: 	points += t->getPoints();
137: 	int up = row-1;
138: 	int down = row+1;
139: 	while(up >= 0 && boardVect[up][col]->occupied()){
140: 		word = boardVect[up][col]->getValue() + word;
141: 		points += boardVect[up][col]->returnPoints();
142: 		up--;
143: 	}	
