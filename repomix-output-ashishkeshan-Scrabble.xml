204: void PlayerDisplay::placePressed()
205: {
206: 	passCounter = 0;
207: 	if(moveField->text().isEmpty()){
208: 		msgBox->setWindowTitle("Error");
209: 		msgBox->setText("Please enter a tile to place!");
210: 		msgBox->setStandardButtons(QMessageBox::Ok);
211: 		msgBox->exec();
212: 		return;
213: 	}
214: 	//check if a square has been selected
215: 	int r = _boardDisp->getRow();
216: 	int c = _boardDisp->getCol();
217: 	int pos = -1;
218: 	if(r == -1){
219: 		msgBox->setWindowTitle("Error");
220: 		msgBox->setText("Please select a square to place the tile on!");
221: 		msgBox->setStandardButtons(QMessageBox::Ok);
222: 		msgBox->exec();
223: 		return;
224: 	}
225: 	int numBlanks = 0;
226: 	bool isValid = false;
227: 	bool isAdj = true;
228: 	bool hasTile = true;
229: 	QAbstractButton* button = moveDirection->checkedButton();
230: 	QString msg = button->text();
231: 	std::string temp  = msg.toStdString();
232: 	char dir = temp[0];
233: 	std::string word = moveField->text().toStdString();
234: 	//handles blank tile case
235: 	for(unsigned int i = 0; i < word.length(); i++){
236: 		if(word[i] == '?')
237: 			numBlanks++;
238: 		else
239: 			word[i] = toupper(word[i]);
240: 		}
241: 	//check if a tile would go out of bounds
242: 	if((dir == '-' && (c - numBlanks + (int)word.length() > board->getColSize())) ||
243: 	(dir == '|' && (r - numBlanks + (int)word.length() > board->getRowSize()))) {
244: 		msgBox->setWindowTitle("Error");
245: 		msgBox->setText("One or more of your tiles would end up out of bounds. \n Please try another move.");
246: 		msgBox->setStandardButtons(QMessageBox::Ok);
247: 		msgBox->exec();
248: 		return;
249: 	}
250: 	//first move must be on starting square
251: 	if(firstMove && !onFirstTile(r,c,dir,word,board)){
252: 		msgBox->setWindowTitle("Error");
253: 		msgBox->setText("First move must start on the starting square. \
254: 			\n Please try another move.");
255: 		msgBox->setStandardButtons(QMessageBox::Ok);
256: 		msgBox->exec();
257: 		return;
258: 	}
259: 	//Check if user has the tiles they selected to place
260: 	for(unsigned int i = 0; i < word.length(); i++){
261: 		if(i != 0 && word[i-1] == '?'){
262: 			continue;
263: 		}
264: 		if(!_UI->players[_UI->getTurn()]->findTile(word[i], pos)){
265: 			msgBox->setWindowTitle("Error");
266: 			msgBox->setText("You do not have this tile. \
267: 			\n Please try another move.");
268: 			msgBox->setStandardButtons(QMessageBox::Ok);
269: 			msgBox->exec();
270: 			moveField->setText("");
271: 			hasTile = false;
272: 			return;
273: 		}
274: 	}
275: 	if(hasTile){
276: 		isValid = _UI->players[_UI->getTurn()]->executePlaceMove(*bag,*dict,*board,dir,r+1,c+1,word,isAdj);
277: 	}
278: 	//check for adjacency in placed tiles
279: 	if(!isValid && !isAdj){
280: 		msgBox->setWindowTitle("Error");
281: 		msgBox->setText("At least one tile must be adjacent to other tiles on the board. \
282: 			Please try another move.");
283: 		msgBox->setStandardButtons(QMessageBox::Ok);
284: 		msgBox->exec();
285: 		return;
286: 	}
287: 	//case if a word created is not valid
288: 	if(!isValid){
289: 		std::string temp = "";
290: 		temp += word;
291: 		msgBox->setWindowTitle("Error");
292: 		temp += " is invalid. Please try again.";
293: 		msgBox->setText(QString::fromStdString(temp));
294: 		msgBox->setStandardButtons(QMessageBox::Ok);
295: 		msgBox->exec();
296: 		moveField->setText("");
297: 		return;
298: 	}	
299: 	//Place tiles and get points + new tiles if valid
300: 	if(isValid){
301: 		firstMove = false;
302: 		_boardDisp->updateBoard();
303: 		std::string temp = "You placed: " + word + "\n";
304: 		temp += "Words formed: ";
305: 		std::vector<std::string> words = _UI->players[_UI->getTurn()]->getWordsFormed();
306: 		for(unsigned int i = 0; i < words.size(); i++){
307: 			temp += words[i];
308: 			temp += " ";
309: 		}
310: 		temp += "\n";
311: 		temp += "You scored: ";
312: 		temp += _UI->players[_UI->getTurn()]->getMoveScore();
313: 		temp += " points!";
314: 		msgBox->setWindowTitle("Place");
315: 		msgBox->setText(QString::fromStdString(temp));
316: 		msgBox->setStandardButtons(QMessageBox::Ok);
317: 		msgBox->exec();
318: 		moveField->setText("");
319: 		if(bag->tilesRemaining() == 0 && _UI->players[_UI->getTurn()]->getHandSize() == 0){
320: 			endGame();
321: 		}
322: 		_UI->switchTurns();
323: 		_scoreDisp->updateScore();
324: 		updateTiles();
325: 	}
326: }
