140: 	int pos = 0;
141: 	int max = 0;
142: 	if(players[_turn]->getHandSize() == 0){
143: 		for(unsigned int i = 0; i < players.size(); i++){
144: 			players[i]->subtractScore(players[i]->getHandScore());
145: 			totScore += players[i]->getHandScore();
146: 		}
147: 		players[_turn]->addScore(totScore);
148: 	}
149: 	cout << "FINAL SCORE:" << endl;
150: 	for(int i = 0; i < _numPlayers; i++){
151: 		if(players[i]->getScore() >= max){
152: 			max = players[i]->getScore();
153: 			pos = i;
154: 		}
155: 		cout << players[i]->getName() << ": " << players[i]->getScore() << endl;
156: 	}
157: 	cout << "THE WINNER IS: " << players[pos]->getName();
158: 	for(int i = 0; i < _numPlayers; i++){
159: 		if(i == pos)
160: 			continue;
161: 		else if(players[i]->getScore() == max){
162: 			cout << ", " << players[i]->getName();
163: 		}
164: 	}
165: 	cout << endl;
166: }
