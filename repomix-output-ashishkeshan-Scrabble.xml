42: //binary search on vector to check if word(s) exist
43: bool Dictionary::checkValid(string word)
44: {
45: 	int min = 0;
46: 	int max = _words.size()-1;
47: 	int index = (max+min)/2;
48: 	while(min <= max){
49: 		if (word.compare(_words[index]) == 0){
50: 			return true;
51: 		}
52: 		else if (word.compare(_words[index]) > 0){
53: 			min = index + 1;
54: 			index = (max+min)/2;
55: 		}
56: 		else if(word.compare(_words[index]) < 0){
57: 			max = index - 1;
58: 			index = (max+min)/2;
59: 		}
60: 	}
61: 	return false;
62: }
