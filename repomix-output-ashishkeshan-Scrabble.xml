328: bool PlayerDisplay::onFirstTile(int row, int col, char dir, std::string word, Board* board)
329: {
330: 	for(int i = 0; i < (int)word.length(); i++){
331: 		if(dir == '|'){
332: 			if(row + i == board->getStartY() && col == board->getStartX())
333: 				return true;
334: 		}
335: 		else if (dir == '-'){
336: 			if(col + i == board->getStartX() && row == board->getStartY())
337: 				return true;
338: 		}
339: 	}
340: 	return false;
341: }
