350: 		temp += "\n";
351: 		temp += "Score Adjustments:\n\n";
352: 		for(unsigned int i = 0; i < _UI->players.size(); i++){
353: 			if((int)i == _UI->getTurn()){
354: 				continue;
355: 			}
356: 			ss.str("");
357: 			ss << _UI->players[i]->getHandScore();
358: 			scoreChange += _UI->players[i]->getHandScore();
359: 			temp += _UI->players[i]->getName();
360: 			temp += " -";
361: 			temp += ss.str();
362: 			temp += " points";
363: 			temp += "\n";
364: 		}
365: 		ss.str("");
366: 		ss << scoreChange;
367: 		temp += _UI->players[_UI->getTurn()]->getName();
368: 		temp += " +";
369: 		temp += ss.str();
370: 		temp += " points";
371: 		temp += "\n";
372: 	}
373: 
374: 	temp += "\nFinal Score:\n\n";
375: 	for(unsigned int i = 0; i < _UI->players.size(); i++){
376: 		ss.str("");
377: 		ss << _UI->players[i]->getScore();
378: 		temp += _UI->players[i]->getName();
379: 		temp += ": ";
380: 		temp += ss.str();
381: 		temp += " points";
382: 		temp += "\n";
383: 	}
384: 	temp += "\n";
385: 	temp += "The winner(s) is(are): ";
386: 	for(unsigned int i = 0; i < winners.size(); i++){
387: 		if(i == winners.size()-1){
388: 			temp += winners[i];
389: 		}
390: 		else{
391: 			temp += winners[i];
392: 			temp += ", ";
393: 		}
394: 	}
395: 	msgBox->setWindowTitle("Game Over");
396: 	msgBox->setText(QString::fromStdString(temp));
397: 	msgBox->setStandardButtons(QMessageBox::Ok);
398: 	msgBox->exec();
399: 	qApp->quit();
