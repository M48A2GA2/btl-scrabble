 95: void gamePlay(Dictionary& dict, Board& board, Bag& bag, int numTiles)
 96: {
 97: 	stringstream ss;
 98: 	string move, word;
 99: 	char dir;
100: 	int r = 0; 
101: 	int c = 0;
102: 	int pos = -1;
103: 	unsigned int counter = 0;
104: 	bool hasTile = true;
105: 	bool firstMove = true;
106: 	bool isValid = true;
107: 	UserInterface UI;
108: 	UI.createNewPlayers(bag, numTiles);
109: 	
110: 	while((bag.tilesRemaining() > 0 || UI.players[UI.getTurn()]->getHandSize() != 0)
111: 		&& (counter != UI.players.size())){
112: 		ss.clear();
113: 		ss.str("");
114: 		UI.printTurn();
115: 		UI.printScore();
116: 		UI.printBoard(board);
117: 		UI.printTiles();
118: 		string line = UI.getMove();
119: 		ss << line;
120: 		ss >> move;
121: 		if(move == "PASS"){
122: 			counter++;
123: 			UI.switchTurns();
124: 		}
125: 		else if(move == "EXCHANGE"){
126: 			counter = 0;
127: 			ss >> word;
128: 			if(ss.fail()){
129: 				cout << "Please enter the right number of parameters.";
130: 				cout << "\n\n";
131: 				continue;
132: 			}
133: 			else{
134: 				for(unsigned int i = 0; i < word.length(); i++){
135: 					word[i] = toupper(word[i]);
136: 				}
137: 			}
138: 			for(unsigned int i = 0; i < word.length(); i++){
139: 				if(!UI.players[UI.getTurn()]->findTile(word[i],pos)){
140: 					cout << "You do not have this tile. Please try again!";
141: 					cout << "\n\n";
142: 					hasTile = false;
143: 					break;
144: 				}
145: 			}
146: 			pos = -1;
147: 			if(!hasTile){
148: 				hasTile = true;
149: 				continue;
150: 			}
151: 			UI.players[UI.getTurn()]->executeExchangeMove(bag, word);
152: 			UI.switchTurns();
153: 		}
154: 		else if (move == "PLACE"){
155: 			counter = 0;
156: 			int numBlanks = 0;
157: 			ss >> dir >> r >> c >> word;
158: 			if(ss.fail()){
159: 				cout << "Command was malformed. Please try another move.";
160: 				cout << "\n\n";
161: 				continue;
162: 			}
163: 			else{
164: 				for(unsigned int i = 0; i < word.length(); i++){
165: 					if(word[i] == '?')
166: 						numBlanks++;
167: 					else
168: 						word[i] = toupper(word[i]);
169: 				}
170: 			}
171: 			if((dir == '-' && (c-1 - numBlanks + (int)word.length() > board.getColSize())) ||
172: 			(dir == '|' && (r-1 - numBlanks + (int)word.length() > board.getRowSize()))) {
173: 				cout << "One or more of your tiles would end up out of bounds. ";
174: 				cout << "Please try another move." << "\n\n";
175: 				continue;
176: 			}
177: 			if(firstMove && !onFirstTile(r-1,c-1,dir,word,board)){
178: 				cout << "First move must start on the starting square. ";
179: 				cout << "Please try another move." << "\n\n";
180: 				continue;
181: 			}
182: 			if(board.boardVect[r-1][c-1]->occupied()){
183: 				cout << "A tile already exists here! Please enter a different position.";
184: 				cout << "\n\n";
185: 				continue;
186: 			}
187: 			for(unsigned int i = 0; i < word.length(); i++){
188: 				if(i != 0 && word[i-1] == '?'){
189: 					continue;
190: 				}
191: 				if(!UI.players[UI.getTurn()]->findTile(word[i], pos)){
192: 					cout << "You do not have this tile. Please try again!";
193: 					cout << "\n\n";
194: 					hasTile = false;
195: 					break;
196: 				}
197: 			}
198: 			pos = -1;
199: 			if(!hasTile){
200: 				hasTile = true;
201: 				continue;
202: 			}
203: 			isValid = UI.players[UI.getTurn()]->executePlaceMove(bag,dict,board,dir,r,c,word);
204: 			if(!isValid) continue;
205: 			firstMove = false;
206: 			UI.switchTurns();
207: 		}
208: 		else{
209: 			cout << "Did not recognize your command. Please try another move!";
210: 			cout << "\n\n";
211: 		}
212: 	}
213: 	UI.endGame();
214: }
