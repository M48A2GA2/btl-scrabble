18: 	std::string line;
19:     bool number = false, hasBoard = false, hasTiles = false, hasDict = false;
20: 
21: 
22: 	if (!configFile.is_open())
23: 		throw invalid_argument("Cannot open file: " + fileName);
24: 	while (getline (configFile, line))
25: 	{
26: 		stringstream ss (line);
27: 		string parameter;
28: 		ss >> parameter;
29: 		if (parameter == "NUMBER:")
30: 			{ ss >> hand_size; number = true; }
31: 		else if (parameter == "BOARD:")
32: 		    { ss >> board_file_name; hasBoard = true; }
33: 		else if (parameter == "TILES:")
34: 			{ ss >> bag_file_name; hasTiles = true; }
35: 		else if (parameter == "DICTIONARY:")
36: 			{ ss >> dictionaryFileName; hasDict = true; }
37: 	}
38: 	if (!number)
39: 		throw invalid_argument("Hand size not specified in config file");
40: 	if (!hasBoard)
41: 		throw invalid_argument("Board file name not specified in config file");
42: 	if (!hasTiles)
43: 		throw invalid_argument("Bag file name not specified in config file");
44: 	if (!hasDict)
45: 		throw invalid_argument("Dictionary file name not specified in config file");
46: 	_dict = new Dictionary(dictionaryFileName);
47: 	_board  = new Board(board_file_name);
48: 	_bag  = new Bag(bag_file_name, time(NULL));
