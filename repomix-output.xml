301: 			words.push_back(word2);
302: 		}
303: 		while(up >= 0 && down < _x){	
304: 			if(boardVect[up][col-1]->occupied()){
305: 				isValid = true;
306: 				tempWord = boardVect[up][col-1]->getValue() + tempWord;
307: 				score += (boardVect[up][col-1]->returnPoints())*multiplier;
308: 				up--;
309: 				continue;
310: 			}
311: 			if(boardVect[down][col-1]->occupied()){
312: 				isValid = true;
313: 				tempWord += boardVect[down][col-1]->getValue();
314: 				score += (boardVect[down][col-1]->returnPoints())*multiplier;
315: 				down++;
316: 				continue;
317: 			}
318: 			else{
319: 				if(counter >= wordLen) break;
320: 				if(usedTiles[counter]->isBlank()){
321: 					tempWord += usedTiles[counter]->getUse();
322: 				}
323: 				else{
324: 					tempWord += usedTiles[counter]->getLetter();
325: 				}
326: 				mult = boardVect[down][col-1]->getMultiplier();
327: 				if(mult == "3n"){
328: 					secondaryMultiplier*=3;
329: 					multiplier*=3;
330: 					score += (usedTiles[counter]->getPoints())*multiplier;
331: 				} 
332: 				else if(mult == "2n"){
333: 					secondaryMultiplier*=2;
334: 					multiplier*=2;
335: 					score += (usedTiles[counter]->getPoints())*multiplier;
336: 				}
337: 				else if(mult == "3") score += (3*usedTiles[counter]->getPoints())*multiplier;
338: 				else if(mult == "2") score += (2*usedTiles[counter]->getPoints())*multiplier;
339: 				else score += (usedTiles[counter]->getPoints())*multiplier;
340: 				points = 0;
