21: using namespace std;
22: 
23: Bag::Bag (const string bag_file_name, int random_seed)
24: {
25: 	srand (random_seed);
26: 	ifstream bagFile (bag_file_name.c_str());
27: 
28: 	if (bagFile.is_open())
29: 	{
30: 		string line;
31: 		while (getline (bagFile, line))
32: 		{
33: 			stringstream ss (line);
34: 			char c;
35: 			int points;
36: 			int count;
37: 			ss >> c >> points >> count;
38: 			for (int i = 0; i < count; ++ i)
39: 			{
40: 				Tile *t = new Tile (toupper(c), points);
41: 				addTile (t);
42: 			}
43: 		}
44: 		bagFile.close ();
45: 	}
46: 	else throw invalid_argument ("Cannot open file: " + bag_file_name);
47: 
48: }
49: 
50: Bag::~Bag ()
51: {
52: 	for (unsigned int i = 0; i < _tiles.size(); ++i)
53: 		delete _tiles [i];
54: }
55: 
56: void Bag::addTile (Tile *tile)
57: {
58: 	_tiles.push_back (tile);
59: 	int j = rand() % _tiles.size();
60: 	_tiles[_tiles.size()-1] = _tiles[j];
61: 	_tiles[j] = tile;
62: }
63: 
64: void Bag::addTiles (vector<Tile*> tiles)
65: {
66: 	for (vector<Tile*>::iterator it = tiles.begin(); it != tiles.end(); ++it)
67: 		addTile (*it);
68: }
69: 
70: std::set<Tile*> Bag::drawTiles (int number)
71: {
72: 	set<Tile*> tileSet;
73: 	for (int i = 0; i < number && tilesRemaining() > 0; ++i)
74: 	{
75: 		tileSet.insert (_tiles.back());
76: 		_tiles.pop_back();
77: 	}
78: 
79: 	return tileSet;
80: }
81: 
82: int Bag::tilesRemaining () const
83: { return _tiles.size(); }
</file>

