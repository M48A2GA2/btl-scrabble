    void addTiles(std::vector<std::unique_ptr<Tile>> tiles);

    bool isEmpty() const noexcept { return tiles.empty(); }
    size_t remainingTiles() const noexcept { return tiles.size(); }

    // Shuffle the bag
    void shuffle();
};

#endif
