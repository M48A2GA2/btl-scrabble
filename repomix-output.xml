#ifndef BOARD_H
#define BOARD_H

#include "Tile.h"
#include <vector>
#include <memory>
#include <utility>
#include <string>

class Board
{
public:
    static const int BOARD_SIZE = 15;

    enum Premium
    {
        NONE,
        DOUBLE_LETTER,
        TRIPLE_LETTER,
        DOUBLE_WORD,
        TRIPLE_WORD,
        START
    };

    struct WordInfo
    {
        std::string word;
        std::vector<std::pair<int, int>> positions;
        int score;
        bool isMainWord;

        WordInfo() : score(0), isMainWord(false) {}
    };

