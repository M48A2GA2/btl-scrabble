23: Dictionary::Dictionary (string dictionary_file_name)
24: {
25: 	ifstream dictFile (dictionary_file_name.c_str());
26: 	string word;
27: 
28: 	if (dictFile.is_open())
29: 	{
30: 		while (getline (dictFile, word))
31: 		{
32: 			word.erase(word.length()); // remove end-of-line character
33: 
34: 			_words.push_back(word);
35: 		}
36: 		sort(_words.begin(), _words.end()); //sort unordered list
37: 		dictFile.close ();
38: 	}
39: 	else throw invalid_argument("Cannot open file: " + dictionary_file_name);
40: }
41: 
42: //binary search on vector to check if word(s) exist
43: bool Dictionary::checkValid(string word)
44: {
45: 	int min = 0;
46: 	int max = _words.size()-1;
47: 	int index = (max+min)/2;
48: 	while(min <= max){
49: 		if (word.compare(_words[index]) == 0){
50: 			return true;
51: 		}
52: 		else if (word.compare(_words[index]) > 0){
53: 			min = index + 1;
54: 			index = (max+min)/2;
55: 		}
56: 		else if(word.compare(_words[index]) < 0){
57: 			max = index - 1;
58: 			index = (max+min)/2;
59: 		}
60: 	}
61: 	return false;
62: }
