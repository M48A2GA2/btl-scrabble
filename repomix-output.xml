 24: Board::Board (string board_file_name)
 25: {
 26: 	isFirstMove = true;
 27: 	ifstream boardFile (board_file_name.c_str());
 28: 	string row;
 29: 
 30: 	_x = _y = _startx = _starty = 0; // to appease compiler
 31: 	if (!boardFile.is_open())
 32: 		throw invalid_argument("Cannot open file: " + board_file_name);
 33: 	getline (boardFile, row);
 34: 	stringstream s1 (row);
 35: 	s1 >> _x >> _y;
 36: 	getline (boardFile, row);
 37: 	stringstream s2 (row);
 38: 	s2 >> _startx >> _starty;
 39: 	_startx --; _starty --;  // coordinates from 0 in array
 40: 
 41: 	// Anything else you need to initialize?
 42: 
 43: 	boardVect.resize(_y);
 44: 	for (int i = 0 ; i < _y; ++ i)
 45: 	{
 46: 		getline (boardFile, row);
 47: 		boardVect[i].resize(_x);
 48: 		for (int j = 0; j < _x; ++ j)
 49: 		{
 50: 			// Fill in the following based on how you store the board.
 51: 			//starting position is 'S'
 52: 			if (i == _starty && j == _startx) 
 53: 			{ 
 54: 				Square *s = new Square(i, j, "***", "2n");
 55: 				boardVect[i][j] = s; 
 56: 			}
 57: 			else switch (row[j]) {
 58: 			case '.' :
 59: 			{
 60: 				Square *s = new Square(i, j, "...", "1");
 61: 				boardVect[i][j] = s;
 62: 				break;
 63: 			} 
 64: 			case '2' : 
 65: 			{
 66: 				Square *s = new Square(i, j, "2L ", "2");
 67: 				boardVect[i][j] = s;
 68: 				break;
 69: 			} 
 70: 			case '3' : 
 71: 			{
 72: 				Square *s = new Square(i, j, "3L ", "3");
 73: 				boardVect[i][j] = s;
 74: 				break;
 75: 			} 
 76: 			case 'd' : 
 77: 			{
 78: 				Square *s = new Square(i, j, "2W ", "2n");
 79: 				boardVect[i][j] = s;
