        TRIPLE_LETTER,
        DOUBLE_WORD,
        TRIPLE_WORD,
        START
    };

    struct WordInfo
    {
        std::string word;
        std::vector<std::pair<int, int>> positions;
        int score;
        bool isMainWord;

