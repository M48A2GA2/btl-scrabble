177: //this function finds the main word created by placed tiles
178: //makes calls to find other words formed by a move
179: //also scores every word that is created by a move
180: vector<string> Board::allWords(int row, int col, char dir, int& score, vector<Tile*>& usedTiles)
181: {
182: 	vector<string> words;
183: 	string tempWord = "";
184: 	int multiplier = 1;
185: 	int secondaryMultiplier = 1;
186: 	int points = 0;
187: 	string word2;
188: 	int right = col;
189: 	int left = col-2;
190: 	if(left == -1){
191: 		left = 0;
192: 	}
193: 	int up = row-2;
194: 	if(up == -1){
195: 		up = 0;
196: 	}
197: 	int down = row;
198: 	int counter = 1;
199: 	bool isValid = false;
200: 	int wordLen = usedTiles.size();
201: 	if(usedTiles[0]->isBlank()){
202: 		tempWord += usedTiles[0]->getUse();
203: 	}
204: 	else{
205: 		tempWord += usedTiles[0]->getLetter();
206: 	}
207: 	string mult = boardVect[row-1][col-1]->getMultiplier();
208: 	if(mult == "3n"){
209: 		multiplier*=3;
210: 		score += (3*usedTiles[0]->getPoints());
211: 	} 
212: 	else if(mult == "2n"){
213: 		multiplier*=2;
214: 		score += (2*usedTiles[0]->getPoints());
215: 
216: 	} 
217: 	else if(mult == "3") score += (3*usedTiles[0]->getPoints());
218: 	else if(mult == "2") score += (2*usedTiles[0]->getPoints());
219: 	else score += (usedTiles[0]->getPoints())*multiplier;
220: 	
221: 	if(dir == '-'){
222: 		points = 0;
223: 		//check if there is are words in vertical direction
224: 		word2 = vertWord(usedTiles[0], row-1, col-1, points);
225: 		if(word2.length() != 1){
226: 			points *= multiplier;
227: 			score += points;
228: 			words.push_back(word2);
229: 		}
230: 		while(left >= 0 && right < _y){	
231: 			//add letters left adjacent to first placed tile
232: 			if(boardVect[row-1][left]->occupied()){
233: 				isValid = true;
234: 				tempWord = boardVect[row-1][left]->getValue() + tempWord;
235: 				score += (boardVect[row-1][left]->returnPoints())*multiplier;
236: 				if(left != 0){
237: 					left--;
238: 					continue;
239: 				}
240: 			}
241: 			//add letters right adjacent to placed tiles
242: 			if(boardVect[row-1][right]->occupied()){
243: 				isValid = true;
244: 				tempWord += boardVect[row-1][right]->getValue();
245: 				score += (boardVect[row-1][right]->returnPoints())*multiplier;
246: 				if (right != _y-1){
247: 					right++;
248: 					continue;
249: 				}
250: 			}
251: 			//else use placed tiles to form word
252: 			else{
253: 				if(counter >= wordLen) break;
254: 				if(usedTiles[counter]->isBlank()){
255: 					tempWord += usedTiles[counter]->getUse();
256: 				}
257: 				else{
258: 					tempWord += usedTiles[counter]->getLetter();
259: 				}
260: 				mult = boardVect[row-1][right]->getMultiplier();
261: 				if(mult == "3n"){
262: 					secondaryMultiplier*=3;
263: 					multiplier*=3;
264: 					score += (usedTiles[counter]->getPoints())*multiplier;
265: 				} 
266: 				else if(mult == "2n"){
267: 					secondaryMultiplier*=2;
268: 					multiplier*=2;
269: 					score += (usedTiles[counter]->getPoints())*multiplier;
270: 				}
271: 				else if(mult == "3") score += (3*usedTiles[counter]->getPoints())*multiplier;
272: 				else if(mult == "2") score += (2*usedTiles[counter]->getPoints())*multiplier;
273: 				else score += (usedTiles[counter]->getPoints())*multiplier;
274: 				points = 0;
275: 				word2 = vertWord(usedTiles[counter], row-1, right, points);
276: 				if(word2.length() != 1){
277: 					points *= secondaryMultiplier;
278: 					score += points;
279: 					words.push_back(word2);
280: 				}
281: 				right++;
282: 				counter++;
283: 			}
284: 
285: 		}
286: 		//if not first move and no adjacent tiles, return empty vector
287: 		if(!isValid && !isFirstMove){
288: 			return words;
289: 		}
290: 		//add word to be checked by dictionary
291: 		words.push_back(tempWord);
292: 	}
293: 	//same as above, replace left with up & right with down
294: 	//forms main word in vertical direction and connected horizontal words
295: 	else if(dir == '|'){
296: 		points = 0;
297: 		word2 = horizWord(usedTiles[0], row-1, col-1, points);
298: 		if(word2.length() != 1){
299: 			points *= multiplier;
