 32: void readConfigFile (string config_file_name,
 33: 					 string & dictionary_file_name,
 34: 					 string & board_file_name,
 35: 					 string & bag_file_name,
 36: 					 unsigned int & hand_size)
 37: {
 38: 	ifstream configFile (config_file_name.c_str());
 39: 	string line;
 40:     bool number = false, hasBoard = false, hasTiles = false, hasDict = false;
 41: 
 42: 	if (!configFile.is_open())
 43: 		throw invalid_argument("Cannot open file: " + config_file_name);
 44: 	while (getline (configFile, line))
 45: 	{
 46: 		stringstream ss (line);
 47: 		string parameter;
 48: 		ss >> parameter;
 49: 		if (parameter == "NUMBER:")
 50: 			{ ss >> hand_size; number = true; }
 51: 		else if (parameter == "BOARD:")
 52: 		    { ss >> board_file_name; hasBoard = true; }
 53: 		else if (parameter == "TILES:")
 54: 			{ ss >> bag_file_name; hasTiles = true; }
 55: 		else if (parameter == "DICTIONARY:")
 56: 			{ ss >> dictionary_file_name; hasDict = true; }
 57: 	}
 58: 	if (!number)
 59: 		throw invalid_argument("Hand size not specified in config file");
 60: 	if (!hasBoard)
 61: 		throw invalid_argument("Board file name not specified in config file");
 62: 	if (!hasTiles)
 63: 		throw invalid_argument("Bag file name not specified in config file");
 64: 	if (!hasDict)
 65: 		throw invalid_argument("Dictionary file name not specified in config file");
 66: }
