342: 				if(word2.length() != 1){
343: 					points *= secondaryMultiplier;
344: 					score += points;
345: 					words.push_back(word2);
346: 				}
347: 				down++;
348: 				counter++;
349: 			}
350: 		}
351: 		if(!isValid && !isFirstMove){
352: 			return words;
353: 		}
354: 		words.push_back(tempWord);
