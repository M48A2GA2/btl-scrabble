124: /*this function encapsulates everything that must happen in a PLACE command
125: calls a function to determine what words are created, then checks those
126: against the dictionary. If the move is valid, the player's score is incremented
127: and the tiles are placed in their proper spot on the board */
128: bool Player::executePlaceMove(Bag& bag, Dictionary& dict, Board& board, char dir, int row, int col, std::string word)
129: {
130: 	vector<string> words;
131: 	vector<Tile*> usedTiles;
132: 	int score = 0;
133: 	for(unsigned int i = 0; i < word.length(); i++){
134: 		returnTile(word[i], usedTiles);
135: 		if (usedTiles[usedTiles.size()-1]->isBlank() && i+1 < word.length()){
136: 			usedTiles[usedTiles.size()-1]->useAs(word[i+1]);
137: 			i++;
138: 		}
139: 	}
140: 
141: 	bool isValid = true;
142: 	
143: 	words = board.allWords(row,col,dir,score,usedTiles);
144: 
145: 	for(unsigned int i = 0; i < words.size(); i++){
146: 		for(unsigned int j = 0; j < words[i].length(); j++){
147: 			(words[i])[j] = tolower((words[i])[j]);
148: 		}
149: 	}
150: 	
151: 	if(words.empty()){
152: 		cout << "At least one tile must be adjacent to other tiles on the board." << endl;
153: 		return false;
154: 	}
155: 
156: 	for(unsigned int i = 0; i < words.size(); i++){
157: 		isValid = dict.checkValid(words[i]);
158: 		if(!isValid){
159: 			cout << words[i] << " is invalid. Please try again." << endl;
160: 			return false;
161: 		}
162: 	}
163: 	if((int)usedTiles.size() == _numTiles){
164: 		score += 50;
165: 	}
166: 	this->addScore(score);
167: 	cout << "Score for this round: " << score << endl;
168: 	unsigned int i = 0;
169: 	bool isOccupied = false;
170: 	while(i < usedTiles.size()){
171: 		isOccupied = board.boardVect[row-1][col-1]->occupied();
172: 		if(dir == '-'){
173: 			if(!isOccupied){
174: 				board.boardVect[row-1][col-1]->setValue(usedTiles[i]);
175: 				this->useTile(usedTiles[i]->getLetter());
176: 				i++;
177: 			}
178: 			col++;
179: 		}
180: 		else if(dir == '|'){
181: 			if(!isOccupied){
182: 				board.boardVect[row-1][col-1]->setValue(usedTiles[i]);
183: 				this->useTile(usedTiles[i]->getLetter());
184: 				i++;
185: 			}
186: 			row++;
187: 		}
188: 	}
189: 	if((int)usedTiles.size() > bag.tilesRemaining()){
190: 		this->getTiles(bag.drawTiles(bag.tilesRemaining()));
191: 	}
192: 	else{
193: 		this->getTiles(bag.drawTiles(usedTiles.size()));
194: 	}
195: 	board.setFirstMove(false);
196: 	return true;
197: }
