126: //this function finds vertical words connected to newly placed horizontal tiles
127: string Board::vertWord(Tile* t, int row, int col, int& points)
128: {
129: 	string word = "";
130: 	if(t->isBlank()){
131: 		word += t->getUse();
132: 	}
133: 	else{
134: 		word += t->getLetter();
135: 	}
136: 	points += t->getPoints();
137: 	int up = row-1;
138: 	int down = row+1;
139: 	while(up >= 0 && boardVect[up][col]->occupied()){
140: 		word = boardVect[up][col]->getValue() + word;
141: 		points += boardVect[up][col]->returnPoints();
142: 		up--;
143: 	}	
144: 	while(down <= _x-1 && boardVect[down][col]->occupied()){
145: 		word += boardVect[down][col]->getValue();
146: 		points += boardVect[down][col]->returnPoints();
147: 		down++;
148: 	}
149: 	return word;
150: }
151: //this function finds horizontal words connected to newly placed vertical tiles
152: string Board::horizWord(Tile* t, int row, int col, int& points)
153: {
154: 	string word = "";
155: 	if(t->isBlank()){
156: 		word += t->getUse();
157: 	}
158: 	else{
159: 		word += t->getLetter();
160: 	}
161: 	points += t->getPoints();
162: 	int right = col+1;
163: 	int left = col-1;
164: 	while(left >= 0 && boardVect[row][left]->occupied()){
165: 		word = boardVect[row][left]->getValue() + word;
166: 		points += boardVect[row][left]->returnPoints();
167: 		left--;
168: 	}	
169: 	while(right <= _y-1 && boardVect[row][right]->occupied()){
170: 		word += boardVect[row][right]->getValue();
171: 		points += boardVect[row][right]->returnPoints();
172: 		right++;
173: 	}
174: 	return word;
175: }
